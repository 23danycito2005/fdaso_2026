<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram id="page-1" name="01 · Mapa de pantallas"><mxGraphModel dx="1700" dy="1220" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1220"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title1" value="01 · Mapa de pantallas&#10;Estructura existente · Las agrupaciones reproducen el menú actual; no son una propuesta de cambio." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff;strokeColor=#b6c8bf;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="65" as="geometry" /></mxCell><mxCell id="A00" value="A00 · PITOCUNA · Aplicación de tesis&#10;Propuesta preliminar, sujeta a modificaciones y validación." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1620" height="75" as="geometry" /></mxCell><mxCell id="S00" value="S00 · Selector superior · siempre visible&#10;Mis datos: proyecto guardado.  |  Prueba vacía: sin registros.  |  Valores predeterminados: ejemplo ficticio.&#10;La opción activa y los contadores se muestran arriba. Mis datos y prueba se guardan por separado." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3da;strokeColor=#b38b3d;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="1620" height="105" as="geometry" /></mxCell><mxCell id="G01" value="RESUMEN&#10;" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f5f4;strokeColor=#bdccc5;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="330" height="50" as="geometry" /></mxCell><mxCell id="M01" value="M01 · Resumen del proyecto&#10;Pendientes y estado general.&#10;Acceso a actividades y componentes.&#10;Revisar ubicación y calendario." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="330" height="155" as="geometry" /></mxCell><mxCell id="G02" value="MENÚ · PREPARAR Y EJECUTAR&#10;" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f5f4;strokeColor=#bdccc5;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="780" height="50" as="geometry" /></mxCell><mxCell id="M02" value="M02 · Actividades&#10;Buscar y filtrar por componente.&#10;Ficha: cronograma + Q/R + APU,&#10;planos, restricciones y compromisos." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="380" height="160" as="geometry" /></mxCell><mxCell id="M03" value="M03 · Lookahead&#10;Ventana de 3, 4, 6 u 8 semanas.&#10;Revisar condiciones y restricciones.&#10;Confirmar preparación cuando procede." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="800" y="400" width="380" height="160" as="geometry" /></mxCell><mxCell id="M04" value="M04 · Restricciones&#10;Problema, responsable y fecha necesaria.&#10;Abierta / en revisión / liberada.&#10;Evidencia y revisión para liberar." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="400" y="590" width="380" height="160" as="geometry" /></mxCell><mxCell id="M05" value="M05 · Plan semanal&#10;Actividad preparada + cantidad + criterio.&#10;Borrador → congelar → evaluar.&#10;Conserva los compromisos del corte." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="800" y="590" width="380" height="160" as="geometry" /></mxCell><mxCell id="M06" value="M06 · Registro de avance&#10;Cantidades diarias y evidencia.&#10;Confirmación de entrega completa.&#10;Interrupciones con fechas y causa." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="400" y="780" width="380" height="160" as="geometry" /></mxCell><mxCell id="M07" value="M07 · Indicadores&#10;PPC, PRL y continuidad.&#10;Reporte CSV, fórmulas e historial.&#10;Resultados a partir de registros." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="800" y="780" width="380" height="160" as="geometry" /></mxCell><mxCell id="G03" value="MENÚ · EXPEDIENTE Y CONFIGURACIÓN&#10;" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f5f4;strokeColor=#bdccc5;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1210" y="330" width="450" height="50" as="geometry" /></mxCell><mxCell id="M08" value="M08 · Visualización de obra&#10;Un mismo espacio para consultar&#10;planos y flujo por componente." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2edfa;strokeColor=#8e78b4;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1210" y="400" width="450" height="100" as="geometry" /></mxCell><mxCell id="M08A" value="M08A · Planos CAD&#10;Visor, zoom y marcas documentales.&#10;Partidas, APU y descarga DWG." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2edfa;strokeColor=#8e78b4;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1210" y="520" width="215" height="160" as="geometry" /></mxCell><mxCell id="M08B" value="M08B · Flujo LBMS&#10;Gráfico tiempo–ubicación.&#10;Plan y pronóstico; puntos&#10;observados cuando existen." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2edfa;strokeColor=#8e78b4;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1445" y="520" width="215" height="160" as="geometry" /></mxCell><mxCell id="M09" value="M09 · Datos de obra&#10;4 pestañas de importación y configuración.&#10;Respaldo JSON y nuevo proyecto." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1210" y="700" width="450" height="95" as="geometry" /></mxCell><mxCell id="M09A" value="M09A · Cronograma&#10;Excel / CSV / Project XML." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1210" y="815" width="215" height="100" as="geometry" /></mxCell><mxCell id="M09B" value="M09B · Metrados y R&#10;Cantidad, unidad y rendimiento." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1445" y="815" width="215" height="100" as="geometry" /></mxCell><mxCell id="M09C" value="M09C · Ubicaciones LBS&#10;Ubicación, grupo y orden." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1210" y="925" width="215" height="100" as="geometry" /></mxCell><mxCell id="M09D" value="M09D · Proyecto/calendario&#10;Jornadas y feriados." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1445" y="925" width="215" height="100" as="geometry" /></mxCell><mxCell id="C00" value="C00 · Controles compartidos&#10;Fecha de corte: limita la observación.&#10;Componente: se conserva entre vistas.&#10;Plan semanal e indicadores evalúan&#10;el corte completo, sin filtrar miembros." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3da;strokeColor=#b38b3d;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="330" height="185" as="geometry" /></mxCell><mxCell id="C01" value="C01 · Cómo pedir un cambio&#10;Usa el código del bloque.&#10;Ejemplo: «Mover M09C bajo M08».&#10;Ese cambio aún NO está aplicado." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f5f4;strokeColor=#bdccc5;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="330" height="165" as="geometry" /></mxCell><mxCell id="L00" value="L00 · LBS ≠ LBMS&#10;LBS organiza los lugares de trabajo. LBMS utiliza esas ubicaciones, cantidades y tiempos para representar el flujo. Los planos CAD son otra vista del expediente." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3da;strokeColor=#b38b3d;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="1620" height="95" as="geometry" /></mxCell><mxCell id="e1-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="M08" target="M08A"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="M08" target="M08B"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="02 · Proceso de trabajo"><mxGraphModel dx="1700" dy="1220" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1220"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title2" value="02 · Proceso de trabajo&#10;Las flechas indican dependencias y decisiones. Una tarea importada no queda preparada automáticamente." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff;strokeColor=#b6c8bf;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="65" as="geometry" /></mxCell><mxCell id="F01" value="F01 · Cargar las fuentes&#10;Cronograma XML / Excel / CSV.&#10;Metrados y catálogo de rendimientos." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="365" height="130" as="geometry" /></mxCell><mxCell id="F02" value="F02 · Revisar la importación&#10;Elegir hoja y columnas; validar errores.&#10;Conservar fechas y precedencias." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="455" y="140" width="365" height="130" as="geometry" /></mxCell><mxCell id="F03" value="F03 · Completar actividad–ubicación&#10;Vincular cantidad Q y rendimiento R.&#10;Definir ubicación, orden y cuadrilla." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="870" y="140" width="365" height="130" as="geometry" /></mxCell><mxCell id="F04" value="F04 · Revisar el Lookahead&#10;¿Qué trabajo se aproxima?&#10;¿Qué condiciones faltan?" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1285" y="140" width="365" height="130" as="geometry" /></mxCell><mxCell id="F05" value="F05 · ¿Está listo para ejecutar?&#10;Comprobar datos, calendario, secuencia,&#10;entregas previas y restricciones." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3da;strokeColor=#b38b3d;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1285" y="390" width="365" height="130" as="geometry" /></mxCell><mxCell id="F06" value="F06 · Gestionar restricciones&#10;Problema + responsable + fecha.&#10;Evidencia y revisión para liberar." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3da;strokeColor=#b38b3d;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="870" y="390" width="365" height="130" as="geometry" /></mxCell><mxCell id="F07" value="F07 · Confirmar preparación&#10;Revisión declarada por responsable.&#10;Recursos, seguridad, calidad y frente." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="455" y="390" width="365" height="130" as="geometry" /></mxCell><mxCell id="F08" value="F08 · Acordar y congelar la semana&#10;Cantidad objetivo y criterio de término.&#10;Guardar miembros y condiciones del corte." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="365" height="130" as="geometry" /></mxCell><mxCell id="F09" value="F09 · Registrar lo observado&#10;Cantidad diaria, fecha, evidencia, entrega.&#10;Interrupciones: intervalo y causa." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="365" height="130" as="geometry" /></mxCell><mxCell id="F10" value="F10 · Evaluar compromisos&#10;Cumplido o no cumplido.&#10;Si falla: causa y acción correctiva." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="455" y="700" width="365" height="130" as="geometry" /></mxCell><mxCell id="F11" value="F11 · Aprender y volver a planificar&#10;PPC / PRL / continuidad.&#10;Revisar causas y próximas decisiones." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="870" y="700" width="365" height="130" as="geometry" /></mxCell><mxCell id="V01" value="V01 · VISUALIZACIÓN DE APOYO · M08&#10;Planos CAD: consultar documentos y partidas.  |  Flujo LBMS: consultar tiempo y ubicación.&#10;Las vistas ayudan a revisar; no crean avance ejecutado ni liberan restricciones por sí solas." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2edfa;strokeColor=#8e78b4;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="1620" height="100" as="geometry" /></mxCell><mxCell id="R01" value="R01 · Reglas que condicionan el proceso&#10;• Una fecha estimada no libera una restricción: se exige evidencia, fecha real y revisión.&#10;• La duración Q/R requiere unidades compatibles y metrado de la ubicación; un total agregado no define frentes.&#10;• El compromiso exige preparación vigente. La semana se congela antes de iniciar; no se añaden miembros después.&#10;• Los registros respetan el corte y el calendario. La falta de registros no demuestra avance físico igual a cero." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3da;strokeColor=#b38b3d;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1620" height="135" as="geometry" /></mxCell><mxCell id="e2-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F01" target="F02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F02" target="F03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F03" target="F04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F04" target="F05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F07" target="F08"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F08" target="F09"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F09" target="F10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F10" target="F11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2-8" value="Faltan condiciones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F05" target="F06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2-9" value="Volver a revisar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F06" target="F05"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1052" y="555" /><mxPoint x="1467" y="555" /></Array></mxGeometry></mxCell><mxCell id="e2-10" value="Condiciones completas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F05" target="F07"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="455" /><mxPoint x="1260" y="315" /><mxPoint x="637" y="315" /></Array></mxGeometry></mxCell><mxCell id="e2-11" value="Siguiente ciclo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="F11" target="F04"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1670" y="765" /><mxPoint x="1670" y="205" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page-3" name="03 · Datos y cálculos"><mxGraphModel dx="1700" dy="1220" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1220"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title3" value="03 · Datos y cálculos&#10;Arquitectura actual · Aplicación estática en navegador, con guardado local y respaldo exportable." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff;strokeColor=#b6c8bf;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="65" as="geometry" /></mxCell><mxCell id="T01" value="T01 · Entradas&#10;Cronograma XML / Excel / CSV.&#10;Metrados Excel / CSV; catálogo APU CSV.&#10;Expediente publicado: PDFs y vistas CAD.&#10;MPP y DWG no se interpretan directamente en el navegador." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="460" height="165" as="geometry" /></mxCell><mxCell id="T02" value="T02 · Interfaz y validación&#10;app.js + importers.js&#10;Formularios, importación, fecha de corte.&#10;workspace-ui.js: resumen y fichas.&#10;Selecciona el proyecto real o la prueba." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="460" height="165" as="geometry" /></mxCell><mxCell id="T03" value="T03 · Modelo del proyecto&#10;Actividades y cantidades por ubicación.&#10;Restricciones y vínculos a actividades.&#10;Planes, avances e interrupciones.&#10;Componentes, fuentes, planos y marcas.&#10;Correspondencias e historial." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="620" y="390" width="460" height="205" as="geometry" /></mxCell><mxCell id="T04" value="T04 · Motor operativo · engine.js&#10;Calendario y duración Q/R.&#10;Precedencias, entregas y cuadrillas.&#10;Preparación y pronóstico condicionado.&#10;Compromisos, PPC, PRL y continuidad." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2fc;strokeColor=#5980ae;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="460" height="205" as="geometry" /></mxCell><mxCell id="T05" value="T05 · Relación documental&#10;relations.js + documents.js&#10;Cruces de WBS, descripción y componente.&#10;Referencias a metrado, APU y plano.&#10;No reparte totales ni inventa ubicaciones.&#10;Un enlace documental no habilita ejecución." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3da;strokeColor=#b38b3d;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1200" y="140" width="460" height="190" as="geometry" /></mxCell><mxCell id="T06" value="T06 · Salidas y visores&#10;Resumen, Lookahead y restricciones.&#10;Plan semanal y registro de avance.&#10;Indicadores, historial y exportaciones.&#10;plans-ui.js: visor CAD.&#10;Flujo LBMS: gráfico de tiempo–ubicación." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2edfa;strokeColor=#8e78b4;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1200" y="390" width="460" height="205" as="geometry" /></mxCell><mxCell id="T07" value="T07 · Mis datos · almacenamiento local&#10;Proyecto guardado en este navegador.&#10;Versión anterior para recuperación.&#10;Exportar / restaurar respaldo JSON.&#10;Sin sincronización entre dispositivos." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3e9;strokeColor=#398267;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="460" height="175" as="geometry" /></mxCell><mxCell id="T08" value="T08 · Prueba · almacenamiento separado&#10;Prueba vacía: inicia sin registros.&#10;Predeterminados: 8 actividades, 4 restricciones&#10;y un plan con 2 compromisos ficticios.&#10;Ambas opciones usan un espacio de prueba.&#10;Mis datos recupera el proyecto anterior." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3da;strokeColor=#b38b3d;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="620" y="740" width="460" height="195" as="geometry" /></mxCell><mxCell id="T09" value="T09 · Alcance de la seguridad actual&#10;Se verifica la estructura de los registros.&#10;La prueba no escribe sobre el proyecto real.&#10;No hay cuentas, roles autenticados ni servidor&#10;de evidencias; el revisor es declarado.&#10;Borrar datos del navegador puede perder registros." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f5f4;strokeColor=#bdccc5;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1200" y="740" width="460" height="195" as="geometry" /></mxCell><mxCell id="T10" value="T10 · Qué significa «conectado»&#10;Conexión operativa: misma partida + ubicación → puede alimentar Q/R y preparación si cumple las demás reglas.&#10;Conexión documental: correspondencia de fuentes → sirve para consultar y revisar, aunque la ejecución siga pendiente.&#10;LBS y cuadrillas reales deben definirse y validarse; los documentos agregados no sustituyen esos datos." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3da;strokeColor=#b38b3d;fontColor=#173c31;fontSize=16;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1620" height="140" as="geometry" /></mxCell><mxCell id="e3-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T01" target="T02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T02" target="T03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T02" target="T05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T05" target="T06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3-4" value="calcular" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T03" target="T04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3-5" value="mostrar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T03" target="T06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3-6" value="resultados calculados" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T04" target="T06"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="620" /><mxPoint x="1430" y="620" /></Array></mxGeometry></mxCell><mxCell id="e3-7" value="guardar / recuperar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T03" target="T07"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="655" /><mxPoint x="270" y="655" /></Array></mxGeometry></mxCell><mxCell id="e3-8" value="solo en modo prueba" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#638173;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T03" target="T08"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>